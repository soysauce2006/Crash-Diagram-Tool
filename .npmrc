auto-install-peers=false
strict-peer-dependencies=false

# Include native binaries for all CI platforms in the lockfile so Windows
# runners (GitHub Actions windows-latest) find the correct optional deps
# (e.g. @rollup/rollup-win32-x64-msvc) without needing a separate install step.
supportedArchitectures[os][]=linux
supportedArchitectures[os][]=win32
supportedArchitectures[cpu][]=x64
